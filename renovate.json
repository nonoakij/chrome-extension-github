{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": ["dependencies", "renovate"],
  "extends": [
    "config:best-practices",
    "group:allNonMajor",
    ":assignAndReview(@nonoakij)",
    ":timezone(Asia/Tokyo)",
    ":prHourlyLimitNone"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core"],
      "groupName": "vite-plus"
    }
  ]
}
