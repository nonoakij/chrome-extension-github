{
	"name": "chrome-extension-github",
	"version": "1.0.4",
	"private": true,
	"description": "Chrome extension to save List of merge commits to Clipboard when creating a PR in Github",
	"keywords": [
		"chrome",
		"extension",
		"github",
		"clipboard"
	],
	"homepage": "",
	"bugs": {
		"url": "https://github.com/nonoakij/chrome-extension-github/issues/"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/nonoakij/chrome-extension-github/"
	},
	"license": "Apache-2.0",
	"author": "nonoakij",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc && esbuild src/index.ts --bundle --minify --outfile=dist/index.js",
		"check": "biome check --write src/",
		"prepare": "husky",
		"type-check": "tsc"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"esbuild": "0.28.1",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"typescript": "7.0.2"
	},
	"lint-staged": {
		"src/*.ts": [
			"biome check"
		]
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.22.0",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "12.14.0",
			"onFail": "download"
		}
	}
}
