{
  "name": "chrome-extension-github",
  "version": "1.1.0",
  "private": true,
  "description": "Chrome extension to save List of merge commits to Clipboard when creating a PR in Github",
  "keywords": [
    "chrome",
    "clipboard",
    "extension",
    "github"
  ],
  "homepage": "",
  "bugs": {
    "url": "https://github.com/nonoakij/chrome-extension-github/issues/"
  },
  "license": "Apache-2.0",
  "author": "nonoakij",
  "repository": {
    "type": "git",
    "url": "https://github.com/nonoakij/chrome-extension-github/"
  },
  "main": "dist/index.js",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "vp lint && vp pack",
    "check": "vp check --fix",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    }
  }
}
